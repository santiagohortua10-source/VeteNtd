# Copia a .env y completa los valores localmente. No publiques .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=REEMPLAZAR_USUARIO_LOCAL
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_LOCAL
DB_NAME=ahp_veterinaria

# Genera valores propios; estos marcadores no son secretos utilizables.
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
JWT_SECRET_KEY=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO
JWT_EXP_MINUTOS=60
COOKIE_SECURE=0

# Completar solo si se habilitan notificaciones MongoDB.
MONGO_URI=mongodb://REEMPLAZAR_HOST:27017/
MONGO_DB=veterinaria_nosql
UMBRAL_STOCK_BAJO=3
NOTIF_DIAS_RETENCION=30
